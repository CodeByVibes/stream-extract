<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StreamExtract.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="StreamExtract.Desktop.Views.AboutDialog"
        x:DataType="vm:AboutViewModel"
        Title="About StreamExtract"
        Width="440" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/AppIcon.ico">

  <Grid Margin="20" RowDefinitions="Auto,*,Auto">
    <!-- Header with Logo and Title -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
      <Button Command="{Binding OpenCudacoderCommand}"
              Background="Transparent"
              BorderThickness="0"
              Padding="0"
              Cursor="Hand"
              ToolTip.Tip="Visit cudacoder.com">
        <Image Source="/Assets/app_logo.png" Width="64" Height="64" />
      </Button>
      <StackPanel VerticalAlignment="Center" Spacing="4">
        <TextBlock Text="{Binding AppTitle}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="CudaCoder" FontSize="13" Foreground="{DynamicResource SystemAccentColor}" />
      </StackPanel>
    </StackPanel>

    <!-- Description & Links -->
    <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center" Margin="0,16,0,0">
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
      
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,8,0,0">
        <Button Content="MKVToolNix"
                Command="{Binding OpenMkvToolnixCommand}"
                Classes="hyperlink"
                Background="Transparent"
                Foreground="{DynamicResource SystemAccentColor}"
                Cursor="Hand" />
        <TextBlock Text="•" VerticalAlignment="Center" Foreground="Gray" />
        <Button Content="GPAC (MP4Box)"
                Command="{Binding OpenMp4boxCommand}"
                Classes="hyperlink"
                Background="Transparent"
                Foreground="{DynamicResource SystemAccentColor}"
                Cursor="Hand" />
      </StackPanel>

      <TextBlock Text="{Binding LicenseInfo}"
                 FontSize="11"
                 Foreground="Gray"
                 TextAlignment="Center"
                 Margin="0,4,0,0" />
    </StackPanel>

    <!-- Close Button -->
    <Button Grid.Row="2"
            Content="Close"
            Width="100"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            Click="Close_Click" />
  </Grid>
</Window>
